  <metadata>
    <name><![CDATA[2026 montanya backpacking]]></name>
    <desc><![CDATA[]]></desc>
    <link href="http://www.alltrails.com">
      <text>AllTrails, LLC</text>
    </link>
    <bounds minlat="45.36248" minlon="-111.46574" maxlat="45.44878" maxlon="-111.37766"/>
  </metadata>
  <wpt lat="45.44793" lon="-111.37767">
    <name><![CDATA[Spanish Creek TH]]></name>
    <desc><![CDATA[Start/finish. Water, vault toilet, parking.]]></desc>
    <sym>Trail Head</sym>
  </wpt>
  <wpt lat="45.41855" lon="-111.40039">
    <name><![CDATA[Falls Ck 410 Jct (approx)]]></name>
    <desc><![CDATA[Loop closes here, ~3 mi from TH. Position estimated from track mileage.]]></desc>
    <sym>Junction</sym>
  </wpt>
  <wpt lat="45.3625" lon="-111.42585">
    <name><![CDATA[C1 Site 56 cap 15+]]></name>
    <desc><![CDATA[Camp 1 primary. Largest site in USFS 2004 survey: 6000 sqft, open forest, 30 ft to creek, 50 ft to trail. Outfitter/stock camp, expect fire ring + manure. Campsite data: USFS Cole/Spildie survey 2004 (RDS-2012-0002); verify condition on arrival.]]></desc>
    <sym>Campground</sym>
  </wpt>
  <wpt lat="45.36096" lon="-111.42611">
    <name><![CDATA[C1 alt Site 66 cap 15+]]></name>
    <desc><![CDATA[Camp 1 fallback. 2100 sqft, open forest, 250 ft to lake. Stock/outfitter camp (site 67 next door is its horse-holding area). Campsite data: USFS Cole/Spildie survey 2004 (RDS-2012-0002); verify condition on arrival.]]></desc>
    <sym>Campground</sym>
  </wpt>
  <wpt lat="45.36146" lon="-111.42575">
    <name><![CDATA[C1 alt Site 61 cap 11-15]]></name>
    <desc><![CDATA[Camp 1 fallback. 1000 sqft, nonforested/densely vegetated, 250 ft to lake, 200 ft to trail. Campsite data: USFS Cole/Spildie survey 2004 (RDS-2012-0002); verify condition on arrival.]]></desc>
    <sym>Campground</sym>
  </wpt>
  <wpt lat="45.36244" lon="-111.42454">
    <name><![CDATA[C1 alt Site 52 cap 7-10]]></name>
    <desc><![CDATA[Camp 1 fallback, foot-use only (no stock recorded). 700 sqft, in a swale, 100 ft to lake, 10 ft to trail. Campsite data: USFS Cole/Spildie survey 2004 (RDS-2012-0002); verify condition on arrival.]]></desc>
    <sym>Campground</sym>
  </wpt>
  <wpt lat="45.37433" lon="-111.43892">
    <name><![CDATA[Divide 9435]]></name>
    <desc><![CDATA[Route high point, Sat mi 1.7. Decision point: past here the short way out is forward.]]></desc>
    <sym>Summit</sym>
  </wpt>
  <wpt lat="45.37753" lon="-111.44458">
    <name><![CDATA[Solitude Site 29 cap 11-15]]></name>
    <desc><![CDATA[Lake Solitude, 50 ft off the Sat traverse at ~mi 2.5. 2000 sqft, open forest, 125 ft to lake. Stock/outfitter camp. Campsite data: USFS Cole/Spildie survey 2004 (RDS-2012-0002); verify condition on arrival.]]></desc>
    <sym>Campground</sym>
  </wpt>
  <wpt lat="45.37718" lon="-111.44466">
    <name><![CDATA[Solitude Site 31 cap 11-15]]></name>
    <desc><![CDATA[Lake Solitude. 1900 sqft, closed forest (best shelter of the big sites), 120 ft to lake. Heavy old horse damage. Campsite data: USFS Cole/Spildie survey 2004 (RDS-2012-0002); verify condition on arrival.]]></desc>
    <sym>Campground</sym>
  </wpt>
  <wpt lat="45.39176" lon="-111.45373">
    <name><![CDATA[UFalls Site 25 cap 7-10]]></name>
    <desc><![CDATA[Upper Falls Creek Lake, quiet alternative 0.6 mi before camp 2. 800 sqft, open forest, 80 ft to lake. Campsite data: USFS Cole/Spildie survey 2004 (RDS-2012-0002); verify condition on arrival.]]></desc>
    <sym>Campground</sym>
  </wpt>
  <wpt lat="45.39288" lon="-111.46166">
    <name><![CDATA[C2 Site 18 cap 7-10]]></name>
    <desc><![CDATA[Camp 2 primary, upper/NE Jerome Rock Lake. 1800 sqft, open forest, 50 ft to lake, 5 ft to trail. Campsite data: USFS Cole/Spildie survey 2004 (RDS-2012-0002); verify condition on arrival.]]></desc>
    <sym>Campground</sym>
  </wpt>
  <wpt lat="45.39256" lon="-111.46128">
    <name><![CDATA[C2 Site 15 cap 3-6]]></name>
    <desc><![CDATA[Overflow tents near Site 18. 1100 sqft, closed forest, 40 ft to lake, 100 ft to trail. Campsite data: USFS Cole/Spildie survey 2004 (RDS-2012-0002); verify condition on arrival.]]></desc>
    <sym>Campground</sym>
  </wpt>
  <wpt lat="45.39122" lon="-111.46093">
    <name><![CDATA[C2 alt Site 22 cap 11-15]]></name>
    <desc><![CDATA[Camp 2 fallback. 2500 sqft by the creek, 200 ft off trail. Surveyed as heavily stock-damaged. Campsite data: USFS Cole/Spildie survey 2004 (RDS-2012-0002); verify condition on arrival.]]></desc>
    <sym>Campground</sym>
  </wpt>
  <wpt lat="45.41514" lon="-111.41832">
    <name><![CDATA[C3 lower Falls Ck (target)]]></name>
    <desc><![CDATA[Camp 3 target area ~7150 ft, dispersed forest camping. No surveyed sites; pick a bench 200 ft off the creek. Campsite data: USFS Cole/Spildie survey 2004 (RDS-2012-0002); verify condition on arrival.]]></desc>
    <sym>Campground</sym>
  </wpt>
  <wpt lat="45.41716" lon="-111.40742">
    <name><![CDATA[Pioneer Falls (approx)]]></name>
    <desc><![CDATA[40-ft falls in a narrow gorge, ~0.5 mi below camp 3. Position estimated from track mileage.]]></desc>
    <sym>Waterfall</sym>
  </wpt>
  <trk>
    <name><![CDATA[2026 montanya backpacking]]></name>
    <src>AllTrails</src>
